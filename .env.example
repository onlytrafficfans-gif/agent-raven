# PostgreSQL connection. Required.
DATABASE_URL="postgresql://agent_raven:change-me@localhost:5432/agent_raven?schema=public"
# Better Auth secret: at least 32 random bytes. Never commit the real value.
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-secret"
BETTER_AUTH_URL="http://127.0.0.1:3000"
# Transactional password-reset email delivery through Resend. Both are required in production.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Agent.Raven <auth@example.com>"
# 32-byte base64 key used for AES-256-GCM encryption of provider credentials.
INTEGRATION_ENCRYPTION_KEY="replace-with-base64-encoded-32-bytes"
# Maximum Apollo credits/calls allowed per organization per UTC month.
APOLLO_MONTHLY_OPERATION_LIMIT="100"
# Optional one-time local seed values. Do not use production credentials here.
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="replace-with-a-strong-local-password"
