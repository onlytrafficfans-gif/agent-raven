{
  "name": "agent-raven",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:backup": "tsx scripts/database-recovery.ts backup",
    "db:restore-drill": "tsx scripts/database-recovery.ts drill"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.10",
    "@next/env": "16.4.2",
    "@prisma/client": "6.12.0",
    "better-auth": "^1.7.10",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "papaparse": "^5.5.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tldts": "^7.0.16",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.4.2",
    "prisma": "6.12.0",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vitest": "^4.0.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/client": true,
    "prisma": true,
    "@prisma/engines": true,
    "@tailwindcss/oxide": true,
    "esbuild@0.25.12": true,
    "unrs-resolver@1.12.2": true
  }
}
